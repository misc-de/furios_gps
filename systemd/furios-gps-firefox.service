[Unit]
# Brings every Firefox profile in line with the switch: the GPS prefs in when
# it is on, out again when it is off. Runs at login (a profile that was open
# during "off" can only be cleaned then) and from furios-gps-firefox.path
# when a new profile appears. Enabled by "furios-gps-firefox on", never by an
# installation.
Description=Let Firefox wait for the GNSS fix

[Service]
Type=oneshot
# A oneshot has no start timeout of its own, and this one is wanted by
# default.target: a hang would hold the session's startup. It only edits
# prefs files, so 30 s is plenty.
TimeoutStartSec=30
ExecStart=/bin/sh -c 'c=%h/.local/bin/furios-gps-firefox; test -x "$$c" || c=/usr/bin/furios-gps-firefox; "$$c" apply'

[Install]
WantedBy=default.target
