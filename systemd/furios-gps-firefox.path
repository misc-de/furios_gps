[Unit]
# The web app manager adds a profile to profiles.ini for every new app; this
# gives that profile the GPS prefs too.
Description=Watch for new Firefox profiles

[Path]
PathChanged=%h/.mozilla/firefox/profiles.ini
Unit=furios-gps-firefox.service

[Install]
WantedBy=default.target
